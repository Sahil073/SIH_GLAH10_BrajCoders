# =============================================================================
# Sanjeevni Workspace .gitignore
# Smart India Hackathon — Wearable Health & Telemetry System
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SENSITIVE CREDENTIALS, SECRETS & KEYS
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
.secret*
credentials.json
google-services.json
GoogleService-Info.plist

# -----------------------------------------------------------------------------
# 2. VOLATILE LOCAL DATABASES & STORAGE
# -----------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
sanjeevni.db
local_storage/

# -----------------------------------------------------------------------------
# 3. SHELL & COMMAND HISTORY
# -----------------------------------------------------------------------------
*.history
.bash_history
.zsh_history
.node_repl_history

# -----------------------------------------------------------------------------
# 4. DEPENDENCIES
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/

# -----------------------------------------------------------------------------
# 5. EXPO, REACT NATIVE & MOBILE BUILDS
# -----------------------------------------------------------------------------
.expo/
**/.expo/
dist/
web-build/
expo-env.d.ts
.metro-cache/
.metro-health-check*
.eas/
*.apk
*.aab
*.ipa
.kotlin/
*.orig.*

# Native prebuild directories (managed dynamically via Expo Prebuild)
mobile-app/android/
mobile-app/ios/
**/android/build/
**/ios/build/

# -----------------------------------------------------------------------------
# 6. LOGS, DIAGNOSTICS & TEST COVERAGE
# -----------------------------------------------------------------------------
*.log
*.log.*
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
coverage/
.nyc_output/

# -----------------------------------------------------------------------------
# 7. TYPESCRIPT & LINTER CACHES
# -----------------------------------------------------------------------------
*.tsbuildinfo
.eslintcache

# -----------------------------------------------------------------------------
# 8. HARDWARE / EMBEDDED BUILD ARTIFACTS (ESP32 Arduino)
# -----------------------------------------------------------------------------
build/
**/build/
*.elf
*.bin
*.hex
*.map
*.o
*.a
*.bak
*.tmp
.arduino15/
**/.arduino15/

# KiCad PCB Design Backups & Locks (Design sources in Sanjeevni_PCB preserved)
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*-bak.kicad_pcb
*-bak.kicad_sch
**/*-backups/
*_autosave-*
*.lck
*.kicad_prl
sym-lib-table
fp-lib-table
*.kicad_mod.bak
*.wrl
*.net
*.easyeda.bak
*.fzbz
*.fzpz.bak

# -----------------------------------------------------------------------------
# 9. IDE, EDITORS & ASSISTANT METADATA
# -----------------------------------------------------------------------------
.vscode/
**/.vscode/
.idea/
**/.idea/
.claude/
**/.claude/
.agents/
**/.agents/
*.code-workspace
*.iml
*.swp
*.swo
*~
\#*\#

# -----------------------------------------------------------------------------
# 10. OPERATING SYSTEM ARTIFACTS
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.nfs*
